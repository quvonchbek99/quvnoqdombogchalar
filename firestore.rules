rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Premium: premium/{uid} hujjati bor va muddati tugamagan
    function isPremium() {
      return signedIn()
        && exists(/databases/$(database)/documents/premium/$(request.auth.uid))
        && get(/databases/$(database)/documents/premium/$(request.auth.uid)).data.until > request.time;
    }
    function str(v, n) { return v is string && v.size() >= 1 && v.size() <= n; }
    // Bilimcoin ₿: har kuni 1 ta (Toshkent vaqti bo'yicha kun), faqat Pro sotib olishda kamayadi
    function cost(days) { return days == 7 ? 15 : (days == 30 ? 50 : 1000000); }
    function tday(t) { return (t + duration.value(5, 'h')).date(); }
    function validProfile(d) {
      return d.keys().hasOnly(['name','group','av','coins','correct','answered','tests','updated','bc','suv','streak','dailyAt'])
        && d.get('bc', 0) is int && d.get('bc', 0) >= 0
        && d.get('suv', 0) is int && d.get('suv', 0) >= 0
        && d.get('streak', 0) is int && d.get('streak', 0) >= 0
        && str(d.name, 40)
        && d.group is string && d.group.size() <= 20
        && d.av is int && d.av >= 0 && d.av < 12
        && d.coins is int && d.coins >= 0 && d.coins <= 100000
        && d.correct is int && d.correct >= 0
        && d.answered is int && d.answered >= 0
        && d.tests is int && d.tests >= 0
        && d.updated == request.time;
    }

    function sameDaily() {
      return request.resource.data.get('bc', 0) == resource.data.get('bc', 0)
        && request.resource.data.get('suv', 0) == resource.data.get('suv', 0)
        && request.resource.data.get('streak', 0) == resource.data.get('streak', 0)
        && request.resource.data.get('dailyAt', null) == resource.data.get('dailyAt', null);
    }
    // Kunlik suv quyish: +1 ₿, +1 suv, kuniga bir marta
    function dailyClaim() {
      return request.resource.data.get('bc', 0) == resource.data.get('bc', 0) + 1
        && request.resource.data.get('suv', 0) == resource.data.get('suv', 0) + 1
        && request.resource.data.get('streak', 0) >= 1
        && request.resource.data.get('streak', 0) <= resource.data.get('streak', 0) + 1
        && request.resource.data.dailyAt == request.time
        && (!('dailyAt' in resource.data) || tday(request.time) > tday(resource.data.dailyAt));
    }
    // Pro sotib olish: shu yozuvning o'zida premium hujjati ham yoziladi
    function purchase(uid) {
      let pp = /databases/$(database)/documents/premium/$(uid);
      return existsAfter(pp)
        && getAfter(pp).data.get('at', null) == request.time
        && request.resource.data.get('bc', 0) == resource.data.get('bc', 0) - cost(getAfter(pp).data.get('days', 0))
        && request.resource.data.get('suv', 0) == resource.data.get('suv', 0)
        && request.resource.data.get('streak', 0) == resource.data.get('streak', 0)
        && request.resource.data.get('dailyAt', null) == resource.data.get('dailyAt', null);
    }
    function buyPro(uid) {
      let d = request.resource.data;
      let up = /databases/$(database)/documents/users/$(uid);
      return d.keys().hasOnly(['until','by','at','days'])
        && d.by == uid && d.at == request.time
        && (d.days == 7 || d.days == 30)
        && d.until is timestamp && d.until > request.time
        && (d.until <= request.time + duration.value(d.days, 'd')
            || (resource != null && d.until <= resource.data.until + duration.value(d.days, 'd')))
        && exists(up) && get(up).data.get('bc', 0) >= cost(d.days)
        && getAfter(up).data.get('bc', 0) == get(up).data.get('bc', 0) - cost(d.days);
    }

    // O'quvchi profili: hamma kirgan foydalanuvchi reytingni ko'ra oladi, o'zgartirish faqat egasiga
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.coins <= 5000
        && request.resource.data.get('bc', 0) == 0
        && request.resource.data.get('suv', 0) == 0;
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.coins >= resource.data.coins
        && request.resource.data.coins - resource.data.coins <= 200
        && request.resource.data.correct >= resource.data.correct
        && request.resource.data.answered >= resource.data.answered
        && request.resource.data.tests >= resource.data.tests
        && (request.resource.data.coins == resource.data.coins
            || request.time > resource.data.updated + duration.value(2, 's'))
        && (sameDaily() || dailyClaim() || purchase(uid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Test natijalari: o'quvchi faqat qo'sha oladi, o'qish va o'chirish faqat o'qituvchiga
    match /results/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','group','topic','correct','total','at'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.name, 40)
        && request.resource.data.group is string && request.resource.data.group.size() <= 20
        && str(request.resource.data.topic, 120)
        && request.resource.data.correct is int && request.resource.data.total is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.total <= 200
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // O'qituvchilar ro'yxati: faqat Firebase konsolidan qo'lda to'ldiriladi
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Premium obuna: egasi o'zinikini ko'radi, yozish faqat o'qituvchiga
    match /premium/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // o'quvchi Bilimcoin ₿ evaziga o'zi uchun Pro oladi (7 kun = 15 ₿, 30 kun = 50 ₿)
      allow create, update: if signedIn() && request.auth.uid == uid && buyPro(uid);
    }

    // To'lov cheklari: egasi yuboradi va o'zinikini ko'radi; tasdiqlash/rad etish faqat o'qituvchi
    match /payments/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','group','note','img','status','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.img is string && request.resource.data.img.size() <= 700000
        && request.resource.data.img.matches('^data:image/(png|jpeg|jpg|webp);base64,[A-Za-z0-9+/=]+$') // faqat rasm (SVG ichida skript bo'lishi mumkin)
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.group is string && request.resource.data.group.size() <= 20
        && request.resource.data.at == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Homiylar reytingi: hamma (kirmagan ham) ko'radi, yozish faqat o'qituvchiga
    match /homiylar/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['ism','summa','havola','xabar','sana','at'])
        && str(request.resource.data.ism, 60)
        && request.resource.data.summa is int && request.resource.data.summa >= 0 && request.resource.data.summa <= 100000000
        && request.resource.data.havola is string && request.resource.data.havola.size() <= 200
        && request.resource.data.xabar is string && request.resource.data.xabar.size() <= 160
        && request.resource.data.sana is string && request.resource.data.sana.size() <= 10;
      allow delete: if isAdmin();
    }

    // Premium test katalogi (nom, savollar soni, narx): kirgan hamma ko'radi
    match /premiumCatalog/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Premium testlar: bepul namunalar hamma kirganga, qolgani faqat obunachiga
    match /premiumTests/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.published == true && (resource.data.free == true || isPremium()));
      allow write: if isAdmin();
    }
  }
}
