{"id":"t70","n":"Aniqmas integral asoslari","q":[[1,"∫−7x⁵ dx ni toping.","−7x⁶/6 + C",["∫xⁿ dx = xⁿ⁺¹/(n + 1) + C","= −7x⁶/6 + C"]],[1,"∫1/x² dx ni toping.","−1/x + C",["Jadval integrali","= −1/x + C"]],[1,"∫3eˣ dx ni toping.","3eˣ + C",["Jadval integrali","= 3eˣ + C"]],[1,"∫e⁴ˣ dx ni toping.","(1/4)·e⁴ˣ + C",["Jadval integrali","= (1/4)·e⁴ˣ + C"]],[1,"∫4cos x dx ni toping.","4·sin x + C",["Jadval integrali","= 4·sin x + C"]],[1,"∫(−4x − 3) dx ni toping.","−2x² − 3x + C",["∫ax dx = ax²/2, ∫b dx = bx","= −2x² − 3x + C"]],[1,"∫−4 dx ni toping.","−4x + C",["∫xⁿ dx = xⁿ⁺¹/(n + 1) + C","= −4x + C"]],[1,"∫e²ˣ dx ni toping.","(1/2)·e²ˣ + C",["Jadval integrali","= (1/2)·e²ˣ + C"]],[1,"∫e³ˣ dx ni toping.","(1/3)·e³ˣ + C",["Jadval integrali","= (1/3)·e³ˣ + C"]],[1,"∫6 dx ni toping.","6x + C",["∫xⁿ dx = xⁿ⁺¹/(n + 1) + C","= 6x + C"]],[1,"∫(4x + 5) dx ni toping.","2x² + 5x + C",["∫ax dx = ax²/2, ∫b dx = bx","= 2x² + 5x + C"]],[1,"∫8 dx ni toping.","8x + C",["∫xⁿ dx = xⁿ⁺¹/(n + 1) + C","= 8x + C"]],[1,"∫sin 2x dx ni toping.","−(1/2)·cos 2x + C",["Jadval integrali","= −(1/2)·cos 2x + C"]],[1,"∫(−5x − 1) dx ni toping.","−5x²/2 − x + C",["∫ax dx = ax²/2, ∫b dx = bx","= −5x²/2 − x + C"]],[2,"∫(6x − 6) dx ni toping.","3x² − 6x + C",["∫ax dx = ax²/2, ∫b dx = bx","= 3x² − 6x + C"]],[2,"∫cos 2x dx ni toping.","(1/2)·sin 2x + C",["Jadval integrali","= (1/2)·sin 2x + C"]],[2,"∫cos x dx ni toping.","sin x + C",["Jadval integral: ∫cos x dx = sin x + C"]],[2,"∫−5x⁵ dx ni toping.","−5x⁶/6 + C",["∫xⁿ dx = xⁿ⁺¹/(n + 1) + C","= −5x⁶/6 + C"]],[2,"∫(−5x − 4) dx ni toping.","−5x²/2 − 4x + C",["∫ax dx = ax²/2, ∫b dx = bx","= −5x²/2 − 4x + C"]],[2,"∫(2x − 5) dx ni toping.","x² − 5x + C",["∫ax dx = ax²/2, ∫b dx = bx","= x² − 5x + C"]],[2,"∫(−6x² + 8x − 8) dx ni toping.","−2x³ + 4x² − 8x + C",["Har bir hadni alohida integrallaymiz","= −2x³ + 4x² − 8x + C"]],[2,"∫3/x dx ni toping.","3·ln|x| + C",["Jadval integrali","= 3·ln|x| + C"]],[2,"f(x) = 8x + 1 funksiyaning F(−1) = 0 shartni qanoatlantiruvchi boshlang'ichini toping.","F(x) = 4x² + x − 3",["F(x) = 4x + 1… → F(x) = 4x² + x + C","F(−1) = 3 + C = 0 → C = -3","F(x) = 4x² + x − 3"]],[2,"∫(4x + 9) dx ni toping.","2x² + 9x + C",["∫ax dx = ax²/2, ∫b dx = bx","= 2x² + 9x + C"]],[2,"∫4/x dx ni toping.","4·ln|x| + C",["Jadval integrali","= 4·ln|x| + C"]],[2,"∫(−3x² − 6x + 7) dx ni toping.","−x³ − 3x² + 7x + C",["Har bir hadni alohida integrallaymiz","= −x³ − 3x² + 7x + C"]],[2,"f(x) = 8x + 6 funksiyaning F(1) = −7 shartni qanoatlantiruvchi boshlang'ichini toping.","F(x) = 4x² + 6x − 17",["F(x) = 4x + 6… → F(x) = 4x² + 6x + C","F(1) = 10 + C = −7 → C = -17","F(x) = 4x² + 6x − 17"]],[2,"∫sin 3x dx ni toping.","−(1/3)·cos 3x + C",["Jadval integrali","= −(1/3)·cos 3x + C"]],[3,"f(x) = 4x + 6 funksiyaning F(3) = 8 shartni qanoatlantiruvchi boshlang'ichini toping.","F(x) = 2x² + 6x − 28",["F(x) = 2x + 6… → F(x) = 2x² + 6x + C","F(3) = 36 + C = 8 → C = -28","F(x) = 2x² + 6x − 28"]],[3,"f(x) = 2x + 3 funksiyaning F(3) = 8 shartni qanoatlantiruvchi boshlang'ichini toping.","F(x) = x² + 3x − 10",["F(x) = x + 3… → F(x) = x² + 3x + C","F(3) = 18 + C = 8 → C = -10","F(x) = x² + 3x − 10"]],[3,"∫(3x + 4) dx ni toping.","3x²/2 + 4x + C",["∫ax dx = ax²/2, ∫b dx = bx","= 3x²/2 + 4x + C"]],[3,"∫x dx ni toping.","x²/2 + C",["∫x dx = x²/2 + C"]],[3,"∫(−2x² − 7x − 2) dx ni toping.","−2x³/3 − 7x²/2 − 2x + C",["Har bir hadni alohida integrallaymiz","= −2x³/3 − 7x²/2 − 2x + C"]],[3,"f(x) = 8x − 5 funksiyaning F(−1) = −4 shartni qanoatlantiruvchi boshlang'ichini toping.","F(x) = 4x² − 5x − 13",["F(x) = 4x − 5… → F(x) = 4x² − 5x + C","F(−1) = 9 + C = −4 → C = -13","F(x) = 4x² − 5x − 13"]],[3,"∫(-3/x + 5x) dx ni toping.","−3ln|x| + 5x²/2 + C",["∫(1/x) dx = ln|x|, ∫x dx = x²/2","= −3ln|x| + 5x²/2 + C"]],[3,"Qaysi funksiya f(x) = 8x ning boshlang'ich funksiyasi?","4x² + 6",["F'(x) = f(x) bo'lishi kerak","(4x² + 6)' = 8x"]],[3,"∫(6x² + 6x + 1) dx ni toping.","2x³ + 3x² + x + C",["Har bir hadni alohida integrallaymiz","= 2x³ + 3x² + x + C"]],[3,"∫(3x + 3) dx ni toping.","3x²/2 + 3x + C",["∫ax dx = ax²/2, ∫b dx = bx","= 3x²/2 + 3x + C"]],[3,"∫(-4/x + 2x) dx ni toping.","−4ln|x| + x² + C",["∫(1/x) dx = ln|x|, ∫x dx = x²/2","= −4ln|x| + x² + C"]],[3,"∫(−4x² − x + 1) dx ni toping.","−4x³/3 − x²/2 + x + C",["Har bir hadni alohida integrallaymiz","= −4x³/3 − x²/2 + x + C"]]]}