{"id":"t96","n":"Nyuton binomi","q":[[1,"(2x − 1)^5 yoyilmasidagi barcha koeffitsiyentlar yig'indisini toping.","1",["x = 1 qo'yamiz","Yig'indi = (2·1 − 1)^5 = 1"]],[1,"(a + b)^4 yoyilmasi koeffitsiyentlari yig'indisi?","16",["a = b = 1: 2^4 = 16"]],[1,"(x + y)^7 yoyilmasida nechta had bor?","8",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 8"]],[1,"(a + b)^5 yoyilmasida nechta had bor?","6",["n + 1 = 6"]],[1,"(x² + 1)^7 yoyilmasida nechta had bor?","8",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 8"]],[1,"(a + b)^9 yoyilmasida 8-hadning binomial koeffitsiyentini toping.","36",["T(k+1) = C(n; k)·aⁿ⁻ᵏ·bᵏ, k = 7","C(9; 7) = 36"]],[1,"(2x + 3)^9 yoyilmasida nechta had bor?","10",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 10"]],[1,"(a + b)^6 yoyilmasi koeffitsiyentlari yig'indisi?","64",["a = b = 1: 2^6 = 64"]],[1,"(x + y)^3 yoyilmasida nechta had bor?","4",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 4"]],[1,"(2x + 1)^3 yoyilmasidagi barcha koeffitsiyentlar yig'indisini toping.","27",["x = 1 qo'yamiz","Yig'indi = (2·1 + 1)^3 = 27"]],[1,"(x + y)^11 yoyilmasida nechta had bor?","12",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 12"]],[1,"(a + b)^5 yoyilmasida a^1·b^4 hadning binomial koeffitsiyentini toping.","5",["T(k+1) = C(n; k)·aⁿ⁻ᵏ·bᵏ, k = 4","C(5; 4) = 5"]],[1,"(a + b)^5 yoyilmasi koeffitsiyentlari yig'indisi?","32",["a = b = 1: 2^5 = 32"]],[1,"(x² + 1)^12 yoyilmasida nechta had bor?","13",["(a + b)ⁿ yoyilmasida n + 1 ta had","= 13"]],[2,"(x − 1)^7 yoyilmasidagi barcha koeffitsiyentlar yig'indisini toping.","0",["x = 1 qo'yamiz","Yig'indi = (1 − 1)^7 = 0"]],[2,"C(9,0) + C(9,1) + … + C(9,9) yig'indisini toping.","512",["2^9 = 512"]],[2,"(3x + 3)^4 yoyilmasida x² oldidagi koeffitsiyentni toping.","486",["Tₖ₊₁ = C(4; 2)·(3x)²·(3)²","= 6·9·9 = 486"]],[2,"(x + 1/x)^4 yoyilmasidagi ozod hadni (x qatnashmagan hadni) toping.","6",["Tₖ₊₁ = C(4; k)·x⁴⁻²ᵏ","4 − 2k = 0 → k = 2","C(4; 2) = 6"]],[2,"C(6,0) + C(6,1) + … + C(6,6) yig'indisini toping.","64",["2^6 = 64"]],[2,"(x − 1)^10 yoyilmasidagi barcha